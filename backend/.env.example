# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ainotes

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Default LLM Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-3.5-turbo

# LLM Providers - 配置对应API Key即可启用对应提供商

## OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

## Kimi - Moonshot AI (https://platform.moonshot.cn/)
KIMI_API_KEY=your_kimi_api_key_here

## DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

## 智谱 AI - Zhipu (https://open.bigmodel.cn/)
ZHIPU_API_KEY=your_zhipu_api_key_here

## 通义千问 - Qwen (https://dashscope.console.aliyun.com/)
QWEN_API_KEY=your_qwen_api_key_here

## 豆包 - Doubao (https://console.volcengine.com/ark/)
DOUBAO_API_KEY=your_doubao_api_key_here

## OpenRouter (多模型聚合 - https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Embedding Providers - 独立配置，可与LLM使用不同供应商

## OpenAI Embedding
EMBEDDING_OPENAI_API_KEY=your_openai_api_key_here

## Kimi Embedding
EMBEDDING_KIMI_API_KEY=your_kimi_api_key_here

## 智谱 Embedding
EMBEDDING_ZHIPU_API_KEY=your_zhipu_api_key_here

## 通义千问 Embedding (推荐: text-embedding-v4)
EMBEDDING_QWEN_API_KEY=your_qwen_api_key_here

## 豆包 Embedding
EMBEDDING_DOUBAO_API_KEY=your_doubao_api_key_here

## OpenRouter Embedding
EMBEDDING_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pinecone (Vector Database)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=ai-notes
PINECONE_ENVIRONMENT=gcp-starter

# ChromaDB (local vector database)
CHROMA_URL=http://localhost:8000

# Server
PORT=3000
