# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ainotes

# Vector store
CHROMA_URL=http://localhost:8000
REINDEX_ON_STARTUP=false

# Auth and encryption
JWT_SECRET=your_super_secret_jwt_key_change_me
API_KEY_ENCRYPTION_SECRET=replace_with_a_32_plus_character_secret
EMAIL_VERIFICATION_SECRET=replace_with_a_32_plus_character_secret
REQUEST_ENCRYPTION_PRIVATE_KEY=

# HTTP security
REQUEST_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY=false
LOG_LEVEL=info

# Email verification
EMAIL_VERIFICATION_EXPOSE_DEV_CODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FAMILY=4
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# CORS
CORS_ALLOWED_ORIGINS=

# LLM and embedding provider API keys are intentionally not configured here.
# Each authenticated user configures their own keys in Settings.
