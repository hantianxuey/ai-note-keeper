{
  "apps": [
    {
      "name": "ai-note-keeper",
      "script": "./dist/server.js",
      "cwd": "/opt/ai-note-keeper/backend",
      "args": "",
      "interpreter": "node",
      "interpreter_args": "--max-old-space-size=256",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000,
        "REINDEX_ON_STARTUP": "false"
      },
      "env_production": {
        "NODE_ENV": "production",
        "REINDEX_ON_STARTUP": "false"
      },
      "instances": 1,
      "exec_mode": "fork",
      "max_memory_restart": "350M",
      "autorestart": true,
      "watch": false,
      "ignore_watch": ["node_modules", ".git"],
      "error_file": "/opt/ai-note-keeper/shared/logs/backend.err.log",
      "out_file": "/opt/ai-note-keeper/shared/logs/backend.out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "merge_logs": true
    }
  ]
}
