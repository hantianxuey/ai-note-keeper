NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:replace-with-password@127.0.0.1:5432/ainotes
CHROMA_URL=http://127.0.0.1:8000
JWT_SECRET=replace-with-strong-secret
API_KEY_ENCRYPTION_SECRET=replace-with-strong-32-plus-character-secret
EMAIL_VERIFICATION_SECRET=replace-with-strong-32-plus-character-secret
REQUEST_ENCRYPTION_PRIVATE_KEY=replace-with-rsa-private-key
TRUST_PROXY=true
EMAIL_VERIFICATION_EXPOSE_DEV_CODE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=replace-with-from-address
CORS_ALLOWED_ORIGINS=https://htxy.top,https://www.htxy.top
